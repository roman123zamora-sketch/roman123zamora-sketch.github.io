/*
 * Exalted Chess — original chess rules module
 *
 * Board coordinates use a1 = 0, b1 = 1, ..., h8 = 63.
 * White moves toward increasing indexes; Black toward decreasing indexes.
 *
 * UI orientation changes only how squares are displayed. It never changes
 * the actual square names or which moves are legal.
 */

export const START_FEN =
  "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";

const FILES = "abcdefgh";
const PROMOTIONS = ["q", "r", "b", "n"];

const PIECE_VALUES = {
  p: 100,
  n: 320,
  b: 330,
  r: 500,
  q: 900,
  k: 0
};

export function squareToIndex(square) {
  if (!/^[a-h][1-8]$/.test(square)) {
    throw new Error(`Invalid chess square: ${square}`);
  }

  const file = FILES.indexOf(square[0]);
  const rank = Number(square[1]) - 1;
  return rank * 8 + file;
}

export function indexToSquare(index) {
  if (!Number.isInteger(index) || index < 0 || index > 63) {
    throw new Error(`Invalid board index: ${index}`);
  }

  return `${FILES[index % 8]}${Math.floor(index / 8) + 1}`;
}

/*
 * Convert a square in the displayed 8×8 grid to its permanent square index.
 * displayRow/displayColumn are each 0–7, starting at the top-left.
 */
export function screenToIndex(displayRow, displayColumn, perspective = "white") {
  if (
    !Number.isInteger(displayRow) ||
    !Number.isInteger(displayColumn) ||
    displayRow < 0 ||
    displayRow > 7 ||
    displayColumn < 0 ||
    displayColumn > 7
  ) {
    throw new Error("Displayed row and column must be between 0 and 7.");
  }

  if (perspective === "white") {
    return (7 - displayRow) * 8 + displayColumn;
  }

  if (perspective === "black") {
    return displayRow * 8 + (7 - displayColumn);
  }

  throw new Error('Perspective must be "white" or "black".');
}

export function indexToScreen(index, perspective = "white") {
  if (!Number.isInteger(index) || index < 0 || index > 63) {
    throw new Error(`Invalid board index: ${index}`);
  }

  const file = index % 8;
  const rank = Math.floor(index / 8);

  if (perspective === "white") {
    return { row: 7 - rank, column: file };
  }

  if (perspective === "black") {
    return { row: rank, column: 7 - file };
  }

  throw new Error('Perspective must be "white" or "black".');
}

function insideBoard(file, rank) {
  return file >= 0 && file <= 7 && rank >= 0 && rank <= 7;
}

function colorOf(piece) {
  if (!piece) return null;
  return piece === piece.toUpperCase() ? "w" : "b";
}

function typeOf(piece) {
  return piece?.toLowerCase() ?? null;
}

function opposite(color) {
  return color === "w" ? "b" : "w";
}

function sameMove(a, b) {
  return (
    a.from === b.from &&
    a.to === b.to &&
    (a.promotion ?? null) === (b.promotion ?? null)
  );
}

function moveToUci(move) {
  return (
    indexToSquare(move.from) +
    indexToSquare(move.to) +
    (move.promotion ?? "")
  );
}

export class ChessPosition {
  constructor(fen = START_FEN) {
    this.board = new Array(64).fill(null);
    this.turn = "w";
    this.castling = "";
    this.enPassant = -1;
    this.halfmoveClock = 0;
    this.fullmoveNumber = 1;
    this.positionCounts = new Map();

    this.loadFEN(fen);
    this.positionCounts.set(this._repetitionKey(), 1);
  }

  loadFEN(fen) {
    const fields = fen.trim().split(/\s+/);
    if (fields.length !== 6) {
      throw new Error("FEN must contain six fields.");
    }

    const [placement, turn, castling, ep, halfmove, fullmove] = fields;
    const rows = placement.split("/");

    if (rows.length !== 8 || !["w", "b"].includes(turn)) {
      throw new Error("Invalid FEN board or active color.");
    }

    const board = new Array(64).fill(null);

    for (let fenRow = 0; fenRow < 8; fenRow++) {
      let file = 0;
      const rank = 7 - fenRow;

      for (const symbol of rows[fenRow]) {
        if (/^[1-8]$/.test(symbol)) {
          file += Number(symbol);
        } else if (/^[pnbrqkPNBRQK]$/.test(symbol)) {
          if (file > 7) throw new Error("Invalid FEN rank width.");
          board[rank * 8 + file] = symbol;
          file++;
        } else {
          throw new Error(`Invalid FEN piece: ${symbol}`);
        }
      }

      if (file !== 8) throw new Error("Each FEN rank must contain 8 squares.");
    }

    this.board = board;
    this.turn = turn;
    this.castling = castling === "-" ? "" : castling;
    this.enPassant = ep === "-" ? -1 : squareToIndex(ep);
    this.halfmoveClock = Number(halfmove);
    this.fullmoveNumber = Number(fullmove);

    if (
      !Number.isInteger(this.halfmoveClock) ||
      !Number.isInteger(this.fullmoveNumber)
    ) {
      throw new Error("Invalid FEN move counters.");
    }

    this.positionCounts = new Map();
    this.positionCounts.set(this._repetitionKey(), 1);
  }

  toFEN() {
    const rows = [];

    for (let rank = 7; rank >= 0; rank--) {
      let row = "";
      let empty = 0;

      for (let file = 0; file < 8; file++) {
        const piece = this.board[rank * 8 + file];

        if (!piece) {
          empty++;
        } else {
          if (empty) row += empty;
          empty = 0;
          row += piece;
        }
      }

      if (empty) row += empty;
      rows.push(row);
    }

    return [
      rows.join("/"),
      this.turn,
      this.castling || "-",
      this.enPassant === -1 ? "-" : indexToSquare(this.enPassant),
      this.halfmoveClock,
      this.fullmoveNumber
    ].join(" ");
  }

  hashKey() {
    return this._repetitionKey();
  }

  _repetitionKey() {
    return [
      this.board.map(piece => piece ?? ".").join(""),
      this.turn,
      this.castling || "-",
      this.enPassant === -1 ? "-" : this.enPassant
    ].join(" ");
  }

  pieceAt(square) {
    return this.board[squareToIndex(square)];
  }

  isSquareAttacked(target, byColor) {
    const targetFile = target % 8;
    const targetRank = Math.floor(target / 8);

    // Pawn attacks.
    const pawnSourceRank = targetRank + (byColor === "w" ? -1 : 1);
    for (const fileOffset of [-1, 1]) {
      const file = targetFile + fileOffset;
      if (!insideBoard(file, pawnSourceRank)) continue;

      const piece = this.board[pawnSourceRank * 8 + file];
      if (piece === (byColor === "w" ? "P" : "p")) return true;
    }

    // Knight attacks.
    const knightOffsets = [
      [1, 2], [2, 1], [2, -1], [1, -2],
      [-1, -2], [-2, -1], [-2, 1], [-1, 2]
    ];

    for (const [df, dr] of knightOffsets) {
      const file = targetFile + df;
      const rank = targetRank + dr;
      if (!insideBoard(file, rank)) continue;

      const piece = this.board[rank * 8 + file];
      if (piece === (byColor === "w" ? "N" : "n")) return true;
    }

    // King attacks.
    for (let df = -1; df <= 1; df++) {
      for (let dr = -1; dr <= 1; dr++) {
        if (df === 0 && dr === 0) continue;

        const file = targetFile + df;
        const rank = targetRank + dr;
        if (!insideBoard(file, rank)) continue;

        const piece = this.board[rank * 8 + file];
        if (piece === (byColor === "w" ? "K" : "k")) return true;
      }
    }

    // Rook, bishop, and queen rays.
    const rays = [
      [1, 0, "rq"], [-1, 0, "rq"], [0, 1, "rq"], [0, -1, "rq"],
      [1, 1, "bq"], [1, -1, "bq"], [-1, 1, "bq"], [-1, -1, "bq"]
    ];

    for (const [df, dr, attackers] of rays) {
      let file = targetFile + df;
      let rank = targetRank + dr;

      while (insideBoard(file, rank)) {
        const piece = this.board[rank * 8 + file];

        if (piece) {
          if (colorOf(piece) === byColor && attackers.includes(typeOf(piece))) {
            return true;
          }
          break;
        }

        file += df;
        rank += dr;
      }
    }

    return false;
  }

  isInCheck(color = this.turn) {
    const king = color === "w" ? "K" : "k";
    const kingSquare = this.board.indexOf(king);

    if (kingSquare === -1) {
      throw new Error(`Position has no ${color === "w" ? "white" : "black"} king.`);
    }

    return this.isSquareAttacked(kingSquare, opposite(color));
  }

  generateLegalMoves({ capturesOnly = false } = {}) {
    const movingColor = this.turn;
    const legal = [];

    for (const move of this._generatePseudoLegalMoves(movingColor)) {
      const isTactical =
        move.capturedPiece !== null || move.promotion !== null;

      if (capturesOnly && !isTactical) continue;

      const undo = this._applyUnchecked(move);
      const leavesKingSafe = !this.isInCheck(movingColor);
      this._restore(undo);

      if (leavesKingSafe) legal.push(move);
    }

    return legal;
  }

  _generatePseudoLegalMoves(color) {
    const moves = [];
    const forward = color === "w" ? 1 : -1;

    const add = (from, to, extras = {}) => {
      if (to < 0 || to > 63) return;

      const target = this.board[to];
      if (target && colorOf(target) === color) return;
      if (target && typeOf(target) === "k") return;

      moves.push({
        from,
        to,
        promotion: null,
        capturedPiece: target ?? null,
        flags: "",
        ...extras
      });
    };

    for (let from = 0; from < 64; from++) {
      const piece = this.board[from];
      if (!piece || colorOf(piece) !== color) continue;

      const type = typeOf(piece);
      const file = from % 8;
      const rank = Math.floor(from / 8);

      if (type === "p") {
        const nextRank = rank + forward;

        if (insideBoard(file, nextRank)) {
          const oneStep = nextRank * 8 + file;

          if (!this.board[oneStep]) {
            this._addPawnMove(moves, from, oneStep, color);

            const startingRank = color === "w" ? 1 : 6;
            const twoRank = rank + 2 * forward;

            if (rank === startingRank && !this.board[twoRank * 8 + file]) {
              moves.push({
                from,
                to: twoRank * 8 + file,
                promotion: null,
                capturedPiece: null,
                flags: "double"
              });
            }
          }
        }

        for (const df of [-1, 1]) {
          const targetFile = file + df;
          const targetRank = rank + forward;
          if (!insideBoard(targetFile, targetRank)) continue;

          const to = targetRank * 8 + targetFile;
          const target = this.board[to];

          if (target && colorOf(target) !== color && typeOf(target) !== "k") {
            this._addPawnMove(moves, from, to, color, target);
          } else if (to === this.enPassant) {
            moves.push({
              from,
              to,
              promotion: null,
              capturedPiece: color === "w" ? "p" : "P",
              flags: "en-passant"
            });
          }
        }
      }

      if (type === "n") {
        const offsets = [
          [1, 2], [2, 1], [2, -1], [1, -2],
          [-1, -2], [-2, -1], [-2, 1], [-1, 2]
        ];

        for (const [df, dr] of offsets) {
          const targetFile = file + df;
          const targetRank = rank + dr;
          if (insideBoard(targetFile, targetRank)) {
            add(from, targetRank * 8 + targetFile);
          }
        }
      }

      if (type === "b" || type === "r" || type === "q") {
        const directions = [];

        if (type !== "b") directions.push([1, 0], [-1, 0], [0, 1], [0, -1]);
        if (type !== "r") directions.push([1, 1], [1, -1], [-1, 1], [-1, -1]);

        for (const [df, dr] of directions) {
          let targetFile = file + df;
          let targetRank = rank + dr;

          while (insideBoard(targetFile, targetRank)) {
            const to = targetRank * 8 + targetFile;
            const target = this.board[to];

            if (!target) {
              add(from, to);
            } else {
              if (colorOf(target) !== color && typeOf(target) !== "k") {
                add(from, to);
              }
              break;
            }

            targetFile += df;
            targetRank += dr;
          }
        }
      }

      if (type === "k") {
        for (let df = -1; df <= 1; df++) {
          for (let dr = -1; dr <= 1; dr++) {
            if (df === 0 && dr === 0) continue;

            const targetFile = file + df;
            const targetRank = rank + dr;
            if (insideBoard(targetFile, targetRank)) {
              add(from, targetRank * 8 + targetFile);
            }
          }
        }

        this._addCastlingMoves(moves, color);
      }
    }

    return moves;
  }

  _addPawnMove(moves, from, to, color, captured = null) {
    const lastRank = color === "w" ? 7 : 0;

    if (Math.floor(to / 8) === lastRank) {
      for (const promotion of PROMOTIONS) {
        moves.push({
          from,
          to,
          promotion,
          capturedPiece: captured,
          flags: "promotion"
        });
      }
    } else {
      moves.push({
        from,
        to,
        promotion: null,
        capturedPiece: captured,
        flags: captured ? "capture" : ""
      });
    }
  }

  _addCastlingMoves(moves, color) {
    const enemy = opposite(color);

    if (color === "w") {
      if (
        this.castling.includes("K") &&
        this.board[4] === "K" &&
        this.board[7] === "R" &&
        !this.board[5] &&
        !this.board[6] &&
        !this.isSquareAttacked(4, enemy) &&
        !this.isSquareAttacked(5, enemy)
      ) {
        moves.push({
          from: 4, to: 6, promotion: null,
          capturedPiece: null, flags: "castle-king"
        });
      }

      if (
        this.castling.includes("Q") &&
        this.board[4] === "K" &&
        this.board[0] === "R" &&
        !this.board[1] &&
        !this.board[2] &&
        !this.board[3] &&
        !this.isSquareAttacked(4, enemy) &&
        !this.isSquareAttacked(3, enemy)
      ) {
        moves.push({
          from: 4, to: 2, promotion: null,
          capturedPiece: null, flags: "castle-queen"
        });
      }
    } else {
      if (
        this.castling.includes("k") &&
        this.board[60] === "k" &&
        this.board[63] === "r" &&
        !this.board[61] &&
        !this.board[62] &&
        !this.isSquareAttacked(60, enemy) &&
        !this.isSquareAttacked(61, enemy)
      ) {
        moves.push({
          from: 60, to: 62, promotion: null,
          capturedPiece: null, flags: "castle-king"
        });
      }

      if (
        this.castling.includes("q") &&
        this.board[60] === "k" &&
        this.board[56] === "r" &&
        !this.board[57] &&
        !this.board[58] &&
        !this.board[59] &&
        !this.isSquareAttacked(60, enemy) &&
        !this.isSquareAttacked(59, enemy)
      ) {
        moves.push({
          from: 60, to: 58, promotion: null,
          capturedPiece: null, flags: "castle-queen"
        });
      }
    }
  }

  /*
   * Use playMove() for a user's move. It checks that the move is legal.
   * Use makeMove() only with a move returned by generateLegalMoves().
   */
  playMove(from, to, promotion = null) {
    const fromIndex = typeof from === "string" ? squareToIndex(from) : from;
    const toIndex = typeof to === "string" ? squareToIndex(to) : to;
    const chosenPromotion = promotion ? promotion.toLowerCase() : null;

    const move = this.generateLegalMoves().find(candidate =>
      candidate.from === fromIndex &&
      candidate.to === toIndex &&
      candidate.promotion === chosenPromotion
    );

    if (!move) {
      throw new Error("That move is illegal in the current position.");
    }

    this.makeMove(move);
    return move;
  }

  makeMove(move) {
    const undo = this._applyUnchecked(move);
    const key = this._repetitionKey();
    this.positionCounts.set(key, (this.positionCounts.get(key) ?? 0) + 1);
    undo.addedRepetitionKey = key;
    return undo;
  }

  unmakeMove(undo) {
    if (undo.addedRepetitionKey) {
      const count = this.positionCounts.get(undo.addedRepetitionKey) ?? 0;
      if (count <= 1) this.positionCounts.delete(undo.addedRepetitionKey);
      else this.positionCounts.set(undo.addedRepetitionKey, count - 1);
    }

    this._restore(undo);
  }

  _applyUnchecked(move) {
    const undo = {
      board: this.board.slice(),
      turn: this.turn,
      castling: this.castling,
      enPassant: this.enPassant,
      halfmoveClock: this.halfmoveClock,
      fullmoveNumber: this.fullmoveNumber
    };

    const piece = this.board[move.from];
    const color = colorOf(piece);
    const type = typeOf(piece);
    let captured = this.board[move.to];

    this.board[move.from] = null;

    if (move.flags === "en-passant") {
      const capturedSquare = move.to + (color === "w" ? -8 : 8);
      captured = this.board[capturedSquare];
      this.board[capturedSquare] = null;
    }

    let placedPiece = piece;
    if (move.promotion) {
      placedPiece = color === "w"
        ? move.promotion.toUpperCase()
        : move.promotion.toLowerCase();
    }

    this.board[move.to] = placedPiece;

    if (move.flags === "castle-king") {
      const rookFrom = color === "w" ? 7 : 63;
      const rookTo = color === "w" ? 5 : 61;
      this.board[rookTo] = this.board[rookFrom];
      this.board[rookFrom] = null;
    } else if (move.flags === "castle-queen") {
      const rookFrom = color === "w" ? 0 : 56;
      const rookTo = color === "w" ? 3 : 59;
      this.board[rookTo] = this.board[rookFrom];
      this.board[rookFrom] = null;
    }

    if (type === "k") {
      this.castling = this.castling.replace(color === "w" ? /[KQ]/g : /[kq]/g, "");
    }

    const rookRights = {
      0: "Q", 7: "K", 56: "q", 63: "k"
    };

    if (type === "r" && rookRights[move.from]) {
      this.castling = this.castling.replace(rookRights[move.from], "");
    }

    if (captured && typeOf(captured) === "r" && rookRights[move.to]) {
      this.castling = this.castling.replace(rookRights[move.to], "");
    }

    this.enPassant = -1;
    if (type === "p" && Math.abs(move.to - move.from) === 16) {
      this.enPassant = (move.from + move.to) / 2;
    }

    this.halfmoveClock = type === "p" || captured ? 0 : this.halfmoveClock + 1;

    if (color === "b") this.fullmoveNumber++;
    this.turn = opposite(color);

    return undo;
  }

  _restore(undo) {
    this.board = undo.board.slice();
    this.turn = undo.turn;
    this.castling = undo.castling;
    this.enPassant = undo.enPassant;
    this.halfmoveClock = undo.halfmoveClock;
    this.fullmoveNumber = undo.fullmoveNumber;
  }

  isInsufficientMaterial() {
    const minors = [];

    for (let square = 0; square < 64; square++) {
      const piece = this.board[square];
      if (!piece || typeOf(piece) === "k") continue;

      const type = typeOf(piece);
      if (["p", "r", "q"].includes(type)) return false;
      minors.push({ type, square });
    }

    if (minors.length <= 1) return true;

    // Bishops only, all bishops on the same color squares.
    if (minors.every(piece => piece.type === "b")) {
      const squareColors = minors.map(({ square }) =>
        ((square % 8) + Math.floor(square / 8)) % 2
      );
      return squareColors.every(color => color === squareColors[0]);
    }

    return false;
  }

  isDraw() {
    const repetitions = this.positionCounts.get(this._repetitionKey()) ?? 0;

    // Automatic draws: fivefold repetition, 75-move rule, or dead material.
    return (
      repetitions >= 5 ||
      this.halfmoveClock >= 150 ||
      this.isInsufficientMaterial()
    );
  }

  canClaimDraw() {
    const repetitions = this.positionCounts.get(this._repetitionKey()) ?? 0;

    // These are claimable by a player; they are not automatic draws.
    return repetitions >= 3 || this.halfmoveClock >= 100;
  }

  getStatus() {
    const inCheck = this.isInCheck();
    const moves = this.generateLegalMoves();

    if (moves.length === 0) {
      return inCheck
        ? { state: "checkmate", winner: opposite(this.turn) }
        : { state: "stalemate", winner: null };
    }

    if (this.isDraw()) return { state: "draw", reason: "automatic-draw" };

    return {
      state: inCheck ? "check" : "playing",
      turn: this.turn,
      canClaimDraw: this.canClaimDraw()
    };
  }

  evaluateForSideToMove() {
    let score = 0;

    for (const piece of this.board) {
      if (!piece) continue;
      const value = PIECE_VALUES[typeOf(piece)];
      score += colorOf(piece) === this.turn ? value : -value;
    }

    return score;
  }
}

export { moveToUci };
