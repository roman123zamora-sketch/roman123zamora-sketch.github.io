/*
 * Exalted Chess Engine — search foundation
 *
 * This file contains the engine's search logic only. It does not create a
 * board, draw pieces, handle clicks, contain openings, or give bots a style.
 *
 * The future board/rules code must provide a position object with:
 *
 *   generateLegalMoves({ capturesOnly })
 *   makeMove(move)                  // returns an undo token
 *   unmakeMove(undoToken)
 *   isInCheck()
 *   isDraw()                        // repetition, 50-move rule, etc.
 *   evaluateForSideToMove()         // score in centipawns
 *   hashKey()                       // unique position key, preferably Zobrist
 *
 * A move should have: from, to, and optional promotion/captured/movingPiece.
 */

const INF = 32000;
const MATE_SCORE = 30000;
const MAX_PLY = 96;
const MAX_QUIESCENCE_PLY = 12;

const PIECE_VALUE = {
  p: 100,
  n: 320,
  b: 330,
  r: 500,
  q: 900,
  k: 20000
};

function now() {
  return globalThis.performance?.now?.() ?? Date.now();
}

function moveKey(move) {
  if (!move) return "";
  return `${move.from}-${move.to}-${move.promotion ?? ""}`;
}

function pieceValue(piece) {
  if (!piece) return 0;
  return PIECE_VALUE[String(piece).toLowerCase()] ?? 0;
}

function capturedPiece(move) {
  return move.capturedPiece ?? move.captured ?? null;
}

function isCapture(move) {
  return Boolean(move.isCapture || capturedPiece(move));
}

function isPromotion(move) {
  return Boolean(move.promotion);
}

function scoreToTable(score, ply) {
  if (score > MATE_SCORE - 1000) return score + ply;
  if (score < -MATE_SCORE + 1000) return score - ply;
  return score;
}

function scoreFromTable(score, ply) {
  if (score > MATE_SCORE - 1000) return score - ply;
  if (score < -MATE_SCORE + 1000) return score + ply;
  return score;
}

const STOP_SEARCH = Symbol("STOP_SEARCH");

export class ChessEngine {
  constructor({ maxTableEntries = 100000 } = {}) {
    this.maxTableEntries = maxTableEntries;
    this.transpositionTable = new Map();
    this.nodes = 0;
    this.deadline = Infinity;
    this.killers = [];
    this.history = new Map();
  }

  /*
   * Search the current position and return the best move found.
   *
   * This is synchronous engine code. Once connected to the website, run it
   * inside a Web Worker so searching does not freeze the page.
   */
  search(position, { maxDepth = 8, timeMs = 1000 } = {}) {
    this._checkPositionInterface(position);

    const startTime = now();
    this.deadline = startTime + Math.max(1, timeMs);
    this.nodes = 0;
    this.killers = Array.from({ length: MAX_PLY }, () => ["", ""]);
    this.history.clear();

    if (position.isDraw()) {
      return this._result(null, 0, 0, startTime, true);
    }

    const rootMoves = position.generateLegalMoves();
    if (rootMoves.length === 0) {
      const score = position.isInCheck() ? -MATE_SCORE : 0;
      return this._result(null, score, 0, startTime, true);
    }

    let completed = {
      bestMove: rootMoves[0],
      score: 0,
      depth: 0
    };

    for (let depth = 1; depth <= maxDepth; depth++) {
      try {
        const iteration = this._searchRoot(position, rootMoves, depth);
        completed = { ...iteration, depth };
      } catch (error) {
        if (error !== STOP_SEARCH) throw error;
        break;
      }
    }

    return this._result(
      completed.bestMove,
      completed.score,
      completed.depth,
      startTime,
      completed.depth === maxDepth
    );
  }

  clearHash() {
    this.transpositionTable.clear();
  }

  _result(bestMove, score, depth, startTime, completed) {
    return {
      bestMove,
      score,
      depth,
      nodes: this.nodes,
      elapsedMs: Math.round(now() - startTime),
      completed
    };
  }

  _checkPositionInterface(position) {
    const required = [
      "generateLegalMoves",
      "makeMove",
      "unmakeMove",
      "isInCheck",
      "isDraw",
      "evaluateForSideToMove",
      "hashKey"
    ];

    for (const name of required) {
      if (typeof position?.[name] !== "function") {
        throw new TypeError(
          `ChessEngine needs position.${name}() from the future board/rules module.`
        );
      }
    }
  }

  _checkTime() {
    this.nodes++;
    if ((this.nodes & 1023) === 0 && now() >= this.deadline) {
      throw STOP_SEARCH;
    }
  }

  _positionKey(position) {
    return String(position.hashKey());
  }

  _searchRoot(position, rootMoves, depth) {
    let alpha = -INF;
    const beta = INF;
    let bestMove = rootMoves[0];
    let bestScore = -INF;

    const key = this._positionKey(position);
    const ttMove = this.transpositionTable.get(key)?.bestMove;
    const moves = this._orderMoves(rootMoves, ttMove, 0);

    for (let index = 0; index < moves.length; index++) {
      this._checkTime();

      const move = moves[index];
      const undoToken = position.makeMove(move);
      let score;

      try {
        if (index === 0) {
          score = -this._negamax(position, depth - 1, -beta, -alpha, 1);
        } else {
          score = -this._negamax(position, depth - 1, -alpha - 1, -alpha, 1);
          if (score > alpha && score < beta) {
            score = -this._negamax(position, depth - 1, -beta, -alpha, 1);
          }
        }
      } finally {
        position.unmakeMove(undoToken);
      }

      if (score > bestScore) {
        bestScore = score;
        bestMove = move;
      }
      if (score > alpha) alpha = score;
    }

    return { bestMove, score: bestScore };
  }

  _negamax(position, depth, alpha, beta, ply) {
    this._checkTime();

    if (position.isDraw()) return 0;
    if (ply >= MAX_PLY) return position.evaluateForSideToMove();
    if (depth <= 0) return this._quiescence(position, alpha, beta, ply, 0);

    const originalAlpha = alpha;
    const key = this._positionKey(position);
    const entry = this.transpositionTable.get(key);
    const ttMove = entry?.bestMove;

    if (entry && entry.depth >= depth) {
      const ttScore = scoreFromTable(entry.score, ply);

      if (entry.bound === "exact") return ttScore;
      if (entry.bound === "lower" && ttScore >= beta) return ttScore;
      if (entry.bound === "upper" && ttScore <= alpha) return ttScore;
    }

    const inCheck = position.isInCheck();
    const moves = this._orderMoves(
      position.generateLegalMoves(),
      ttMove,
      ply
    );

    if (moves.length === 0) {
      return inCheck ? -MATE_SCORE + ply : 0;
    }

    let bestScore = -INF;
    let bestMove = null;

    for (let index = 0; index < moves.length; index++) {
      const move = moves[index];
      const undoToken = position.makeMove(move);
      let score;

      try {
        if (index === 0) {
          score = -this._negamax(position, depth - 1, -beta, -alpha, ply + 1);
        } else {
          score = -this._negamax(
            position,
            depth - 1,
            -alpha - 1,
            -alpha,
            ply + 1
          );

          if (score > alpha && score < beta) {
            score = -this._negamax(
              position,
              depth - 1,
              -beta,
              -alpha,
              ply + 1
            );
          }
        }
      } finally {
        position.unmakeMove(undoToken);
      }

      if (score > bestScore) {
        bestScore = score;
        bestMove = move;
      }
      if (score > alpha) alpha = score;

      if (alpha >= beta) {
        this._recordCutoff(move, depth, ply);
        break;
      }
    }

    let bound = "exact";
    if (bestScore <= originalAlpha) bound = "upper";
    else if (bestScore >= beta) bound = "lower";

    this._store(key, {
      depth,
      score: scoreToTable(bestScore, ply),
      bound,
      bestMove
    });

    return bestScore;
  }

  _quiescence(position, alpha, beta, ply, qply) {
    this._checkTime();

    if (position.isDraw()) return 0;
    if (ply >= MAX_PLY) return position.evaluateForSideToMove();

    const inCheck = position.isInCheck();

    if (!inCheck) {
      const standPat = position.evaluateForSideToMove();
      if (standPat >= beta) return standPat;
      if (standPat > alpha) alpha = standPat;

      if (qply >= MAX_QUIESCENCE_PLY) return standPat;
    }

    const moves = position.generateLegalMoves(
      inCheck ? {} : { capturesOnly: true }
    );

    if (moves.length === 0) {
      return inCheck ? -MATE_SCORE + ply : alpha;
    }

    const ordered = this._orderMoves(moves, null, ply);
    let bestScore = inCheck ? -INF : alpha;

    for (const move of ordered) {
      const undoToken = position.makeMove(move);
      let score;

      try {
        score = -this._quiescence(
          position,
          -beta,
          -alpha,
          ply + 1,
          qply + 1
        );
      } finally {
        position.unmakeMove(undoToken);
      }

      if (score > bestScore) bestScore = score;
      if (score > alpha) alpha = score;
      if (alpha >= beta) break;
    }

    return bestScore;
  }

  _orderMoves(moves, ttMove, ply) {
    const ttKey = moveKey(ttMove);
    const killerMoves = this.killers[ply] ?? ["", ""];

    return [...moves].sort((a, b) => {
      return this._moveScore(b, ttKey, killerMoves) -
             this._moveScore(a, ttKey, killerMoves);
    });
  }

  _moveScore(move, ttKey, killerMoves) {
    const key = moveKey(move);

    if (key && key === ttKey) return 10_000_000;

    if (isCapture(move)) {
      const victim = pieceValue(capturedPiece(move)) || 100;
      const attacker = pieceValue(move.movingPiece) || 100;
      return 1_000_000 + victim * 10 - attacker;
    }

    if (isPromotion(move)) {
      return 900_000 + pieceValue(move.promotion);
    }

    if (key === killerMoves[0]) return 800_000;
    if (key === killerMoves[1]) return 700_000;

    return this.history.get(key) ?? 0;
  }

  _recordCutoff(move, depth, ply) {
    if (isCapture(move) || isPromotion(move)) return;

    const key = moveKey(move);
    if (!key) return;

    const killers = this.killers[ply];
    if (killers && killers[0] !== key) {
      killers[1] = killers[0];
      killers[0] = key;
    }

    const oldScore = this.history.get(key) ?? 0;
    this.history.set(key, Math.min(1_000_000, oldScore + depth * depth));
  }

  _store(key, entry) {
    if (this.transpositionTable.size >= this.maxTableEntries) {
      this.transpositionTable.clear();
    }
    this.transpositionTable.set(key, entry);
  }
}

export default ChessEngine;
